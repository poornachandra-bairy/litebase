# Litebase configuration.
#
# Copy to .env and adjust. Every value here is optional except the admin
# credentials on first start; the defaults produce a working local server.
# These are read at startup, so restart after changing them.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Address to listen on. Use 127.0.0.1:8090 to accept only local connections.
LITEBASE_ADDR=0.0.0.0:8090

# Public URL, used in generated API documentation. Leave blank to infer it
# from the request.
LITEBASE_BASE_URL=

# Where all data lives: databases, backups, metadata and temporary files.
LITEBASE_DATA_DIR=./data

# Optional separate location for backups, e.g. a mounted volume.
# LITEBASE_BACKUP_DIR=/mnt/backups

# Serve the dashboard from a directory instead of the embedded bundle.
# LITEBASE_STATIC_DIR=

# ---------------------------------------------------------------------------
# First administrator
# ---------------------------------------------------------------------------
# Used only when the instance has no users yet. If the password is left blank,
# a strong one is generated and printed to stdout once, on first start.

LITEBASE_ADMIN_EMAIL=admin@example.com
LITEBASE_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------

# Forces the Secure flag on cookies. You usually do not need this: Litebase
# already sets Secure automatically whenever a request arrives over HTTPS,
# including through a TLS-terminating proxy. Turn it on to require HTTPS even
# for requests that appear to arrive over plain HTTP.
LITEBASE_SECURE_COOKIES=false

# Set to true only when running behind a reverse proxy you control. It makes
# the server trust X-Forwarded-For for client addresses, which a direct client
# could otherwise spoof to evade rate limiting.
LITEBASE_TRUST_PROXY=false

# How long a session stays valid. Activity extends it.
LITEBASE_SESSION_TTL=168h

# Restrict the session cookie to one domain. Leave blank for the request host.
# LITEBASE_COOKIE_DOMAIN=

# Extra origins allowed to call the API with credentials, comma separated.
# Only needed when the dashboard is served from a different origin.
# LITEBASE_ALLOWED_ORIGINS=https://admin.example.com

# ---------------------------------------------------------------------------
# Backups
# ---------------------------------------------------------------------------

# Encrypts backups with AES-256-GCM before they leave the server, and encrypts
# stored cloud credentials. Generate one with: openssl rand -base64 48
# Losing this key makes existing encrypted backups unrecoverable.
LITEBASE_BACKUP_ENCRYPTION_KEY=

# How often the scheduler checks for due backups.
LITEBASE_SCHEDULER_INTERVAL=1m

# ---------------------------------------------------------------------------
# Limits
# ---------------------------------------------------------------------------

# Maximum rows returned by one SQL editor or API request.
LITEBASE_MAX_QUERY_ROWS=5000

# How long a single query may run before it is cancelled.
LITEBASE_QUERY_TIMEOUT=30s

# Maximum JSON request body, and maximum database/backup upload.
LITEBASE_MAX_BODY_BYTES=2MB
LITEBASE_MAX_UPLOAD_BYTES=512MB

# How many user databases may be open at once.
LITEBASE_MAX_OPEN_DATABASES=64

# Rate limits, per client, per minute. The auth limit guards sign-in against
# password guessing, so keep it low.
LITEBASE_ADMIN_RATE_PER_MIN=600
LITEBASE_API_RATE_PER_MIN=120
LITEBASE_AUTH_RATE_PER_MIN=10

# ---------------------------------------------------------------------------
# Timeouts and logging
# ---------------------------------------------------------------------------

LITEBASE_READ_TIMEOUT=30s
LITEBASE_WRITE_TIMEOUT=120s
LITEBASE_SHUTDOWN_TIMEOUT=15s

# debug | info | warn | error
LITEBASE_LOG_LEVEL=info
# json | text
LITEBASE_LOG_FORMAT=json

# Relaxes the Content-Security-Policy for the Vite dev server. Never enable
# this in production.
LITEBASE_DEV_MODE=false

# ---------------------------------------------------------------------------
# docker compose only
# ---------------------------------------------------------------------------
LITEBASE_PORT=8090
LITEBASE_VERSION=latest
